    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح الوصول إلى الكاميرا للتطبيق بتعيين صور خلفية مخصصة وبيانات السمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Kamera ermöglicht es der App, benutzerdefinierte Hintergrundbilder und Themendaten festzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access allows the app to set custom background images and theme data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara permite a la aplicación establecer imágenes de fondo personalizadas y datos para los temas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbibigay-daan ang access sa camera sa app na magtakda ng mga custom na background image at data ng tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à l'appareil photo permet à l'application de définir des images d'arrière-plan et des données de thème personnalisées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा एक्सेस ऐप को कस्टम बैकग्राउंड इमेज और थीम डेटा सेट करने की अनुमति देता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksè nan kamera pèmèt aplikasyon an mete imaj background koutim ak done tèm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスにより、アプリでカスタムの背景画像やテーマデータを設定できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 액세스를 통해 앱에서 사용자 지정 배경 이미지 및 테마 데이터를 설정할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере позволяет приложению устанавливать пользовательские фоновые изображения и данные тем."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhusa ya kamera inaruhusu programu kuweka picha maalum za mandharinyuma na data ya mandhari."
