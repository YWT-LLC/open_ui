        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до камери дозволяє програмі встановлювати власні фонові зображення та дані тем."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机权限允许应用设置自定义背景图像和主题数据。"
